+.vl-side input[type=radio],.vl-side input[type=checkbox] { accent-color: #22d3ee; }
diff --git a/engineering-quest/src/game/screens/VisualLibraryScreen.test.ts b/engineering-quest/src/game/screens/VisualLibraryScreen.test.ts
