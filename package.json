{
  "name": "engineering-quest",
  "private": true,
  "version": "0.47.0",
  "type": "module",
  "description": "ENGINEERING QUEST - an RPG that teaches mathematics from arithmetic to engineering.",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "assets:icons": "node scripts/fetch-icons.mjs",
    "assets:manifest": "node scripts/build-asset-manifest.mjs",
    "assets:check": "node scripts/check-assets.mjs",
    "build:single": "vite build -c vite.single.config.ts && node scripts/make-single-file.mjs"
  },
  "dependencies": {
    "@fontsource/exo-2": "^5.3.0",
    "@fontsource/orbitron": "^5.3.0",
    "peerjs": "^1.5.5",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "three": "^0.186.0"
  },
  "devDependencies": {
    "@types/node": "^22.20.1",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@types/three": "^0.185.4",
    "@vitejs/plugin-react": "^4.3.4",
    "jsdom": "^25.0.1",
    "typescript": "^5.6.3",
    "vite": "^5.4.11",
    "vite-plugin-singlefile": "^2.3.3",
    "vitest": "^2.1.8"
  }
}
